# Copy to .env for running on your computer. On Hostinger, enter these under
# "Environment variables" in the Node.js app settings instead (do not upload .env).

# MySQL database (hPanel → Databases → Management)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_erp
DB_USER=u123456789_erp
DB_PASSWORD=your-database-password
# ...or one line instead of the five above:
# DATABASE_URL=mysql://user:password@localhost:3306/dbname

# Optional. If left out, a random secret is created and kept in the database.
# JWT_SECRET=a-long-random-string

# Optional. Days a phone stays logged in (default 30).
# TOKEN_DAYS=30

# Only used if the database has no owner login yet (fresh install without backup.sql).
# OWNER_USERNAME=jeet
# OWNER_NAME=Jeet Shah
# OWNER_PASSWORD=pick-a-strong-one

# Port for local runs. Hostinger sets PORT itself.
PORT=3000
